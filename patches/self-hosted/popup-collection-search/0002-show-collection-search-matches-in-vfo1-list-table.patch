+import { ComponentFixture, TestBed } from "@angular/core/testing";
+import { mock } from "jest-mock-extended";
+
+import { CollectionView } from "@bitwarden/common/admin-console/models/collections";
+import { I18nService } from "@bitwarden/common/platform/abstractions/i18n.service";
+
+import { VaultSearchCollectionsComponent } from "./vault-search-collections.component";
+
+describe("VaultSearchCollectionsComponent", () => {
+  let fixture: ComponentFixture<VaultSearchCollectionsComponent>;
+
+  const collections = [
+    { id: "col-1", name: "Alpha" },
+    { id: "col-2", name: "Beta" },
+  ] as unknown as CollectionView[];
+
+  const element = (): HTMLElement => fixture.nativeElement;
+  const names = (): string[] =>
+    Array.from(element().querySelectorAll<HTMLElement>('[data-testid="collection-name"]')).map(
+      (el) => el.textContent?.trim() ?? "",
+    );
+
+  beforeEach(async () => {
+    await TestBed.configureTestingModule({
+      imports: [VaultSearchCollectionsComponent],
+      providers: [
+        { provide: I18nService, useValue: mock<I18nService>({ t: (key: string) => key }) },
+      ],
+    }).compileComponents();
+
+    fixture = TestBed.createComponent(VaultSearchCollectionsComponent);
+    fixture.componentRef.setInput("collections", collections);
+  });
+
+  it("lists the collections in a section by default", () => {
+    fixture.detectChanges();
+
+    expect(element().querySelector("bit-section")).toBeTruthy();
+    expect(element().querySelector('[data-testid="collection-matches"]')).toBeNull();
+    expect(names()).toEqual(["Alpha", "Beta"]);
+  });
+
+  it("lays the collections out as one row of buttons when compact", () => {
+    fixture.componentRef.setInput("compact", true);
+    fixture.detectChanges();
+
+    expect(element().querySelector("bit-section")).toBeNull();
+    expect(element().querySelector('[data-testid="collection-matches"]')).toBeTruthy();
+    expect(names()).toEqual(["Alpha", "Beta"]);
+  });
+
+  it.each([false, true])("emits the picked collection (compact: %s)", (compact) => {
+    const picked: CollectionView[] = [];
+    fixture.componentInstance.collectionSelected.subscribe((collection) => picked.push(collection));
+    fixture.componentRef.setInput("compact", compact);
+    fixture.detectChanges();
+
+    element().querySelectorAll("button")[1].click();
+
+    expect(picked).toEqual([collections[1]]);
+  });
+
+  it("renders nothing when there are no collections", () => {
+    fixture.componentRef.setInput("collections", []);
+    fixture.componentRef.setInput("compact", true);
+    fixture.detectChanges();
+
+    expect(element().querySelector("button")).toBeNull();
+  });
+});
